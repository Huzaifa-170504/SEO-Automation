# Existing Telegram interface
TELEGRAM_BOT_TOKEN=
TELEGRAM_PROXY_URL=
AUTHORIZED_TELEGRAM_USER_ID=
AUTHORIZED_CHAT_ID=

# Content providers (GEMINI_API_KEY is required for the hosted content demo)
GEMINI_API_KEY=
GEMINI_MODEL=
CONTENT_MODEL_PROVIDER=gemini
CONTENT_MODEL_FALLBACK_PROVIDER=qwen
OLLAMA_BASE_URL=http://127.0.0.1:11434
QWEN_MODEL=

# Set CONTENT_MODEL_FALLBACK_PROVIDER to an empty value on Vercel unless a
# remotely reachable fallback provider is configured. The qwen default is local-only.

# Recruiter demo API
APP_ENV=development
FRONTEND_ORIGINS=http://localhost:5173,https://huzaifa-170504.github.io
DEMO_MAX_PAGES=15
DEMO_RETENTION_HOURS=24
DEMO_RATE_LIMIT_PER_HOUR=3
DEMO_TIMEOUT_SECONDS=180
DEMO_REQUEST_TIMEOUT_SECONDS=12
RATE_LIMIT_SALT=

# Configure all three values together to enable durable demo persistence.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_REPORT_BUCKET=seo-demo-reports
